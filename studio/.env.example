# Studio environment. Copy to `.env.local` for `npm run dev`, or to `.env.production` (with the production URL below) before `npm run deploy`.
# `.env.*` files are gitignored (only this example is committed). Nothing here is a secret.

# URL of the public site that the Presentation tool loads in its preview pane, and that
# click-to-edit / draft mode run against. Studio env vars are baked in at build time, so
# after changing this value run `npm run deploy` again.
#
#   local dev (`npm run dev`) : http://localhost:3000   (also the default when this is unset)
#   hosted Studio (deploy)    : the production site URL, e.g. https://vazeerart.com
#                               (the *.vercel.app URL is fine until the domain is attached)
#
# Use the exact origin the site is served from (scheme, apex vs www, no trailing slash), and add
# that origin to the project's CORS list with credentials: see "Deployment" in the root README.
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
