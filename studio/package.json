{
  "name": "vazeer-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "schema:validate": "sanity schema validate",
    "schema:extract": "sanity schema extract --enforce-required-fields --force --path=./schema.json",
    "typegen": "npm run schema:extract && sanity typegen generate",
    "seed": "sanity exec scripts/seed.ts --with-user-token",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/orderable-document-list": "^2.0.25",
    "@sanity/vision": "^6.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.16.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
