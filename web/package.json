{
  "name": "vazeer-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:styles": "node tools/verify-styles.mjs",
    "perf": "node tools/lighthouse.mjs",
    "e2e:baseline": "VISUAL_SOURCE=original playwright test tests/e2e/visual.spec.ts --grep-invert '@ 390' --update-snapshots",
    "e2e:baseline:mobile": "VISUAL_SOURCE=site playwright test tests/e2e/visual.spec.ts --grep '@ 390' --update-snapshots=all",
    "e2e": "VISUAL_SOURCE=site playwright test"
  },
  "dependencies": {
    "@sanity/client": "^8.8.0",
    "@sanity/image-url": "^2.1.1",
    "next": "^16.3.7",
    "next-sanity": "^13.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
